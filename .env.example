# ============================================================================
# MyPrimeCompany — MASTER environment reference (COMMITTED — placeholders only)
#
# This file documents every variable used in the monorepo. It is NOT loaded by
# the apps. Copy the relevant values into the gitignored files below:
#
#   apps/web/.env.local      URL + ANON_KEY                      (public site)
#   apps/crm/.env.local      URL + ANON_KEY + SERVICE_ROLE_KEY   (admin console)
#   supabase/seed/.env       URL + SERVICE_ROLE_KEY + ADMIN_*    (seed/bootstrap)
#
# Each of those directories has its own .env.example to copy from.
# ============================================================================

# ── Public (safe to expose in a browser bundle) ─────────────────────────────
# The anon key is DESIGNED to be public — it is restricted by Row Level Security.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Optional (apps/web only) ────────────────────────────────────────────────
# Absolute origin used for canonical/OG tags and sitemap.xml. Leave unset on
# Vercel — it falls back to the auto-injected production URL. Set it once you
# point a custom domain at the project.
# NEXT_PUBLIC_SITE_URL=https://www.myprimecompany.in

# ── SECRET (server-only — NEVER expose) ─────────────────────────────────────
# Bypasses Row Level Security entirely. Anyone holding this can read/write ALL
# customer data. Deliberately NOT prefixed NEXT_PUBLIC_ so Next.js can never
# inline it into client JS. Used only by:
#   • supabase/seed scripts
#   • apps/crm/lib/supabase/admin.ts (staff invites, super-admin gated)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
