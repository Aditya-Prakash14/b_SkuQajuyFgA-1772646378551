{
  "name": "prime-home-care",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @prime/web dev",
    "dev:crm": "pnpm --filter @prime/crm dev",
    "//dev:partner": "apps/partner is outside the pnpm workspace (Expo + Metro vs. pnpm symlinks) — it is an npm project.",
    "dev:partner": "npm --prefix apps/partner run start",
    "build:web": "pnpm --filter @prime/web build",
    "build:crm": "pnpm --filter @prime/crm build",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "bash scripts/e2e.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "seed": "pnpm --filter @prime/supabase-seed seed",
    "bootstrap": "pnpm --filter @prime/supabase-seed bootstrap"
  },
  "devDependencies": {
    "vitest": "^2"
  }
}
