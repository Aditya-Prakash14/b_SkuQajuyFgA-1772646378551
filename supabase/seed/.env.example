# ============================================================================
# MyPrimeCompany — SEED & BOOTSTRAP SCRIPTS (supabase/seed)
# Copy to `.env` (gitignored) and fill in real values.
#   cp supabase/seed/.env.example supabase/seed/.env
#
# Used by:
#   pnpm seed        → loads the service catalog
#   pnpm bootstrap   → creates the first super_admin CRM account
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# ── SECRET — bypasses Row Level Security. Local/CI only, never in a browser. ──
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── First super_admin created by `pnpm bootstrap` ────────────────────────────
# Change the password immediately after the first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-after-first-login
ADMIN_NAME=Your Name
