# ============================================================================
# MyPrimeCompany — PUBLIC WEBSITE (apps/web)
# Copy to `.env.local` (gitignored) and fill in real values.
#   cp apps/web/.env.example apps/web/.env.local
# ============================================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Online payments (Razorpay). Set to true AFTER the razorpay-create-order /
# razorpay-webhook function secrets are configured — until then the functions
# answer 503 and the "Pay now" buttons stay hidden anyway.
# NEXT_PUBLIC_ONLINE_PAYMENTS=true

# The merchant key id (public identifier, not a secret). The /pay page pins
# Checkout to this key so a crafted link cannot collect money for a foreign
# Razorpay account on our domain.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx

# Optional. Absolute origin for canonical/OG tags and sitemap.xml.
# Unset on Vercel = falls back to the auto-injected production URL.
# NEXT_PUBLIC_SITE_URL=https://www.myprimecompany.in

# ⚠️  DO NOT add SUPABASE_SERVICE_ROLE_KEY here.
# The website only ever uses the anon key. Row Level Security restricts it to:
#   • reading the active catalog
#   • booking via the create_booking() RPC (requires Google sign-in)
# The service-role key would bypass all of that.
