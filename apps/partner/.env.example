# ============================================================================
# MyPrimeCompany — PARTNER APP (apps/partner, Expo)
# Copy to `.env` (gitignored) and fill in real values.
#   cp apps/partner/.env.example apps/partner/.env
#
# EXPO_PUBLIC_* is inlined into the JS bundle by Metro at build time. Restart
# with `npx expo start -c` after changing these or the stale value persists.
# ============================================================================

# Supabase → Project Settings → API. Same project as apps/web and apps/crm.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ⚠️  NEVER add SUPABASE_SERVICE_ROLE_KEY here.
# A mobile bundle is fully readable by anyone who installs the app. The partner
# app only ever needs the anon key — RLS plus the SECURITY DEFINER RPCs in
# migration 0008 are what scope a partner to their own vendor row.
