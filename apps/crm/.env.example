# ============================================================================
# MyPrimeCompany — ADMIN CRM (apps/crm)
# Copy to `.env.local` (gitignored) and fill in real values.
#   cp apps/crm/.env.example apps/crm/.env.local
# ============================================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── SECRET — server-only ────────────────────────────────────────────────────
# Used ONLY by apps/crm/lib/supabase/admin.ts to provision staff accounts
# (Settings → Invite admin), and only after a super_admin check.
# No NEXT_PUBLIC_ prefix => Next.js never inlines it into client JS.
# On Vercel: add as a plain Environment Variable (not exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
