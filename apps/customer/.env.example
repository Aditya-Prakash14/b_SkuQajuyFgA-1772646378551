# ============================================================================
# MyPrimeCompany — customer app (apps/customer)
# Copy to `.env` (gitignored) and fill in.
#   cp apps/customer/.env.example apps/customer/.env
#
# EXPO_PUBLIC_* is inlined by Metro at BUNDLE time — restart `npx expo start -c`
# after editing or the old value stays baked into the bundle.
# ============================================================================
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
